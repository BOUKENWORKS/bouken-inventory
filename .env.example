# このファイルを .env.production.local としてコピーし、値を埋めてから `npm run build` してください。
# (.env.production.local は .gitignore 済みでコミットされません)
#
# server/api/ を同一オリジンで配信する場合は VITE_API_BASE_URL に "/api" のような
# 相対パスを指定できます(CORS設定不要)。別ドメインに配置する場合はフルURLを指定し、
# server/api/config.php の allowed_origins にこのフロントエンドのオリジンを追加してください。
VITE_API_BASE_URL=/api

# server/api/config.php の api_key と同じ値にしてください。
# ビルド後のJSバンドルに埋め込まれるため真の秘匿値にはなりません(server/README.md参照)。
VITE_API_KEY=CHANGE_ME_TO_A_RANDOM_STRING
